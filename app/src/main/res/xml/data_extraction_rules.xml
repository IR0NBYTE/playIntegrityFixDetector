<?xml version="1.0" encoding="utf-8"?>
<!--
  android:allowBackup="false" governs cloud backup. On Android 12 and above
  device-to-device transfer is governed here instead and is NOT implied by it,
  so it is denied explicitly: a root and tamper detector's stored state has no
  reason to be cloned onto another handset.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
