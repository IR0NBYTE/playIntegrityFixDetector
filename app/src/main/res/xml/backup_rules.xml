<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup is already disabled outright by android:allowBackup="false", so these
  rules should never be consulted. They are written out explicitly rather than
  left as the IDE's commented-out template so that turning backup on later
  cannot silently begin shipping this app's state off the device.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
